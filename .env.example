# Copy this to apps/api/.env for local development.
# This is the single source of truth for variable NAMES; every dev/service
# must use these exact keys (see config.module.ts validation).

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://exam_user:exam_pass@localhost:5432/secure_exam

JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3001

THROTTLE_TTL=60
THROTTLE_LIMIT=10
